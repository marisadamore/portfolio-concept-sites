---
import '../styles/global.css'; import Header from '../components/Header.astro';
const { title, active, description = 'Lily Smith is an author, brand educator, and self-publishing coach helping thoughtful experts share their work.' }=Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><title>{title}</title></head><body><Header active={active}/><main><slot/></main><footer class="shell"><a class="wordmark" href="/">Lily <i>Smith</i></a><p>Fictional concept brand for portfolio demonstration.</p><p>© 2026</p></footer></body></html>
