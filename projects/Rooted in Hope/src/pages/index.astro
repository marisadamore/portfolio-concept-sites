---
import '../styles/global.css';
const schedule=[['4:30 PM','Garden gates open','Seasonal bites, community art, and a welcome drink.'],['5:30 PM','Stories from the soil','Meet the young growers and neighborhood leaders behind the work.'],['6:15 PM','A table for everyone','Family-style spring supper prepared by local chefs.'],['7:30 PM','Music under the lights','A joyful closing set, dessert, and one last toast.']];
const impact=[['14','neighborhood gardens'],['8,400','fresh meals shared'],['320','young growers taught']];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><meta name="description" content="Rooted in Hope is a fictional spring benefit supporting community gardens, youth education, and food access."><title>Rooted in Hope — Spring Benefit</title></head><body>
<div class="demo-note">Portfolio concept · Fictional 501(c)(3) community organization</div>
<header class="site-header"><a class="brand" href="#top" aria-label="Rooted in Hope home"><span class="brand-mark"><i></i><i></i><i></i></span><span><b>ROOTED</b><small>TOGETHER</small></span></a><button class="nav-toggle" aria-expanded="false" aria-controls="main-nav"><span></span><span></span><span></span><b class="sr-only">Open menu</b></button><nav id="main-nav" aria-label="Main navigation"><a href="#about">Our mission</a><a href="#impact">Our impact</a><a href="#evening">Event details</a></nav><a class="header-cta" href="#tickets">Get tickets <span>→</span></a></header>
<main id="top">
<section class="hero"><div class="hero-copy"><div><p class="eyebrow">Rooted in Hope · 2027 Spring Benefit</p><h1>Plant<br><i>possibility.</i><br>Grow community.</h1><p class="hero-lede">An outdoor celebration funding neighborhood gardens, youth education, and fresh food access across Jacksonville.</p></div><div class="hero-bottom"><p><b>Saturday, May 15 · 4:30 PM</b><br>The Glasshouse Garden · Jacksonville, FL</p><a class="button coral" href="#tickets">Get event tickets</a></div></div><div class="hero-art" aria-label="Colorful illustration of a flourishing community garden"><div class="sun"></div><div class="hill hill-one"></div><div class="hill hill-two"></div><svg class="botanical botanical-one" viewBox="0 0 180 360" aria-hidden="true"><path d="M92 355C83 269 91 172 88 26"/><path d="M89 107C55 91 35 67 32 40C63 42 85 62 89 107Z"/><path d="M89 174C126 157 147 130 148 100C115 105 92 134 89 174Z"/><path d="M89 245C49 226 26 195 25 163C62 169 85 202 89 245Z"/></svg><svg class="botanical botanical-two" viewBox="0 0 180 330" aria-hidden="true"><path d="M91 328C95 236 92 151 96 32"/><path d="M95 94C124 80 145 58 150 34C121 33 101 54 95 94Z"/><path d="M94 157C60 145 38 122 31 92C62 92 88 118 94 157Z"/><path d="M93 226C124 209 142 185 144 158C115 163 96 189 93 226Z"/></svg><div class="flower flower-one">✿</div><div class="flower flower-two">✦</div><div class="flower flower-three">✿</div><div class="art-label"><span>15</span><small>May<br>2027</small></div></div></section>
<section class="ticker" aria-label="Event themes"><span>Gather</span><b>✿</b><span>Nourish</span><b>✿</b><span>Celebrate</span><b>✿</b><span>Grow</span><b>✿</b></section>
<section class="intro" id="about"><div><p class="eyebrow">What takes root</p><h2>One beautiful evening.<br><i>A year of change.</i></h2></div><div class="intro-copy"><p>Join neighbors, educators, growers, and local leaders for an evening celebrating what happens when a community invests in itself.</p><p>Every ticket helps turn overlooked spaces into gardens, fresh food into shared meals, and curious young people into confident stewards of their neighborhoods.</p><a class="text-link" href="#impact">See our growing impact ↓</a></div></section>
<section class="trust-strip" aria-label="Ways to participate"><p><b>Can’t attend?</b> You can still help a neighborhood garden thrive.</p><div><a href="#tickets">Make a demo gift</a><a href="#volunteer">Volunteer with us</a><a href="#partners">Become a partner</a></div></section>
<section class="impact" id="impact"><div class="impact-art"><div class="arch-sky"><span class="sprout">⌇</span><span class="small-leaf">◒</span></div><p>Growth is a<br><i>community practice.</i></p></div><div class="impact-copy"><p class="eyebrow">Last season, together</p><h2>Small seeds.<br>Real momentum.</h2><div class="impact-grid">{impact.map(([number,label])=><div><strong>{number}</strong><span>{label}</span></div>)}</div><p class="fine">Rooted Together is a fictional nonprofit created to demonstrate mission-driven storytelling and event design.</p></div></section>
<section class="evening" id="evening"><div class="section-title"><p class="eyebrow">The evening unfolds</p><h2>Come as you are.<br><i>Leave more connected.</i></h2></div><div class="timeline">{schedule.map(([time,title,text],i)=><article><span>0{i+1}</span><time>{time}</time><div><h3>{title}</h3><p>{text}</p></div></article>)}</div></section>
<section class="community-cards" id="volunteer"><article><span>01</span><h3>Give your time</h3><p>Join a garden workday, pack produce boxes, or mentor a young grower.</p><a href="#tickets">Explore volunteer roles →</a></article><article id="partners"><span>02</span><h3>Fund a full season</h3><p>Help cover tools, seedlings, water access, and educator stipends.</p><a href="#tickets">View partner opportunities →</a></article><article><span>03</span><h3>Bring your people</h3><p>Reserve a community table and celebrate with eight friends or colleagues.</p><a href="#tickets">Choose a ticket →</a></article></section>
<section class="tickets" id="tickets"><div class="ticket-copy"><p class="eyebrow">Save your seat</p><h2>Choose how<br>you’ll help it grow.</h2><p>This interactive ticket selector is a portfolio demo. No payment will be collected.</p></div><form class="ticket-card" id="ticket-form"><fieldset><legend>Ticket type</legend><label><input type="radio" name="ticket" value="45" checked><span><b>Garden guest</b><small>Admission + supper</small></span><strong>$45</strong></label><label><input type="radio" name="ticket" value="85"><span><b>Community builder</b><small>Admission + sponsor a youth seat</small></span><strong>$85</strong></label><label><input type="radio" name="ticket" value="150"><span><b>Harvest circle</b><small>Admission + garden-season support</small></span><strong>$150</strong></label></fieldset><div class="quantity"><label for="quantity">Guests</label><div><button type="button" data-step="-1" aria-label="Remove a guest">−</button><output id="quantity">1</output><button type="button" data-step="1" aria-label="Add a guest">+</button></div></div><label class="donation"><input type="checkbox" id="donation"><span><b>Add a seed gift</b><small>Put an extra $20 toward spring seedlings.</small></span></label><div class="total"><span>Demo total</span><strong id="total">$45</strong></div><button class="button navy" type="submit">Continue — demo only <span>↗</span></button><p class="form-message" role="status"></p></form></section>
<section class="closing"><div class="closing-flower">✿</div><p class="eyebrow">Saturday, May 15</p><h2>Let’s grow something<br><i>good together.</i></h2><a class="button coral" href="#tickets">Join the table</a></section></main>
<footer><a class="brand" href="#top"><span class="brand-mark"><i></i><i></i><i></i></span><span><b>ROOTED</b><small>TOGETHER</small></span></a><p>Spring Benefit · Jacksonville, Florida</p><small>© 2027 · Portfolio concept</small></footer>
<script>const navButton=document.querySelector('.nav-toggle');const nav=document.querySelector('#main-nav');navButton?.addEventListener('click',()=>{const open=nav?.classList.toggle('open');navButton.setAttribute('aria-expanded',String(Boolean(open)))});nav?.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>{nav.classList.remove('open');navButton?.setAttribute('aria-expanded','false')}));const form=document.querySelector('#ticket-form');const quantityOutput=document.querySelector('#quantity');const totalOutput=document.querySelector('#total');let quantity=1;const updateTotal=()=>{const price=Number(form?.querySelector('input[name="ticket"]:checked')?.value||45);const gift=document.querySelector('#donation')?.checked?20:0;if(quantityOutput)quantityOutput.textContent=String(quantity);if(totalOutput)totalOutput.textContent=`$${price*quantity+gift}`};form?.querySelectorAll('input').forEach(input=>input.addEventListener('change',updateTotal));form?.querySelectorAll('[data-step]').forEach(button=>button.addEventListener('click',()=>{quantity=Math.min(10,Math.max(1,quantity+Number(button.dataset.step)));updateTotal()}));form?.addEventListener('submit',event=>{event.preventDefault();const message=form.querySelector('.form-message');if(message)message.textContent='Demo complete — in a live campaign, this would continue to secure checkout.'});</script></body></html>
