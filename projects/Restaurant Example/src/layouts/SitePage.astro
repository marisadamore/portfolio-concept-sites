---
import '../styles/global.css';
const { title, description, active } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><title>{title}</title></head><body>
<header><a class="logo" href="/" aria-label="Tide and Toast home"><span class="wave" aria-hidden="true"><i></i><i></i><i></i></span><span><b>Tide</b><small>& Toast</small></span></a><nav aria-label="Main navigation"><a class={active==='home'?'active':''} href="/">Home</a><a class={active==='menu'?'active':''} href="/menu">Menu</a><a class={active==='about'?'active':''} href="/about">About</a><a class={active==='contact'?'active':''} href="/contact">Contact</a></nav><a class="order" href="/menu">Order online</a></header>
<main><slot /></main>
<footer><a class="logo" href="/"><span class="wave" aria-hidden="true"><i></i><i></i><i></i></span><span><b>Tide</b><small>& Toast</small></span></a><p>COFFEE · PASTRIES · BRUNCH</p><small>© 2026 Tide & Toast</small></footer>
</body></html>
